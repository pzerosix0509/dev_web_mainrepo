<%- include('partials/header') %>

<section class="py-20 bg-[#0c0b09]">
  <div class="container mx-auto px-4 max-w-lg text-center">
    <div class="bg-[#1a1814] border border-red-500/40 rounded-2xl p-10 shadow-2xl">
      <div class="font-serif text-6xl sm:text-7xl font-bold text-red-400 mb-4">500</div>
      <h1 class="text-2xl font-serif text-white mb-3">
        <%= typeof message !== 'undefined' ? message : 'Lỗi máy chủ' %>
      </h1>
      <p class="text-xs sm:text-sm text-[#bab8b2] mb-8 leading-relaxed">
        Máy chủ không thể hoàn tất yêu cầu. Vui lòng thử lại sau.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a href="/" class="btn btn-gold text-xs uppercase tracking-wider font-semibold px-6 py-3 rounded-full">
          &larr; Về Trang Chủ
        </a>
        <a href="/menu" class="btn btn-outline-gold text-xs uppercase tracking-wider font-semibold px-6 py-3 rounded-full">
          Xem Thực Đơn
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
