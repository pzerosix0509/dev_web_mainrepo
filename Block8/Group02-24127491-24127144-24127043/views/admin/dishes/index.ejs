<%- include('../../partials/header') %>

<section class="py-12 bg-[#0c0b09]">
  <div class="container mx-auto px-4">
    
    <!-- Tiêu đề trang & Nút thêm mới -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <span class="text-xs uppercase tracking-widest text-[#cda45e] font-semibold">BẢNG ĐIỀU KHIỂN QUẢN TRỊ</span>
        <h1 class="text-3xl font-serif text-white mt-1">Danh Sách Món Ăn</h1>
      </div>
      <a href="/admin/dishes/new" class="btn btn-gold text-xs uppercase tracking-wider font-semibold px-6 py-3 rounded-full shadow-lg">
        + Thêm Món Ăn Mới
      </a>
    </div>

    <!-- Bảng danh sách Món Ăn -->
    <div class="bg-[#1a1814] border border-[#cda45e]/20 rounded-xl overflow-hidden shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-[#12100d] border-b border-[#cda45e]/30 text-[#cda45e] font-serif text-xs uppercase tracking-wider">
              <th class="py-4 px-6">ID</th>
              <th class="py-4 px-6">Tên Món Ăn</th>
              <th class="py-4 px-6">Danh Mục</th>
              <th class="py-4 px-6">Giá (VNĐ)</th>
              <th class="py-4 px-6">Trạng Thái</th>
              <th class="py-4 px-6 text-right">Thao Tác</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#28251f] text-sm text-[#bab8b2]">
            <% if (dishes.length === 0) { %>
              <tr>
                <td colspan="6" class="py-8 text-center text-[#7f7c75]">
                  Chưa có món ăn nào trong thực đơn.
                </td>
              </tr>
            <% } else { %>
              <% dishes.forEach(dish => { %>
                <tr class="hover:bg-white/[0.02] transition">
                  <td class="py-4 px-6 font-mono text-xs text-[#cda45e]">#<%= dish.id %></td>
                  <td class="py-4 px-6">
                    <a href="/dishes/<%= dish.id %>" class="font-serif font-bold text-white hover:text-[#cda45e] transition text-base block">
                      <%= dish.name %>
                    </a>
                    <p class="text-xs text-[#7f7c75] truncate max-w-xs mt-0.5">
                      <%= dish.description %>
                    </p>
                  </td>
                  <td class="py-4 px-6">
                    <span class="text-xs text-[#cda45e] bg-[#cda45e]/10 border border-[#cda45e]/20 px-2.5 py-1 rounded">
                      <%= dish.category %>
                    </span>
                  </td>
                  <td class="py-4 px-6 font-semibold text-white">
                    <%= Number(dish.price).toLocaleString('vi-VN') %> đ
                  </td>
                  <td class="py-4 px-6">
                    <% if (dish.available) { %>
                      <span class="text-xs text-green-400 bg-green-500/10 border border-green-500/30 px-2.5 py-1 rounded font-medium">
                        Còn Món
                      </span>
                    <% } else { %>
                      <span class="text-xs text-amber-400 bg-amber-500/10 border border-amber-500/30 px-2.5 py-1 rounded font-medium">
                        Tạm Hết
                      </span>
                    <% } %>
                  </td>
                  <td class="py-4 px-6 text-right whitespace-nowrap">
                    <a href="/admin/dishes/<%= dish.id %>/edit" class="btn btn-outline-gold btn-sm mr-2 text-xs">
                      Sửa
                    </a>
                    <a href="/admin/dishes/<%= dish.id %>/delete" class="btn btn-danger btn-sm text-xs">
                      Xóa
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<%- include('../../partials/footer') %>
