<%- include('../partials/header') %>

<section class="py-16 bg-[#0c0b09]">
  <div class="container mx-auto px-4 max-w-5xl">
    
    <!-- Breadcrumb -->
    <div class="mb-8 text-xs uppercase tracking-wider text-[#a8a59e] flex items-center gap-2">
      <a href="/menu" class="hover:text-[#cda45e] transition">Thực Đơn</a>
      <span>/</span>
      <span class="text-[#cda45e]"><%= dish.category %></span>
      <span>/</span>
      <span class="text-white"><%= dish.name %></span>
    </div>

    <!-- Card Chi Tiết Món Ăn Phong Cách Specials (Hình ảnh 5) -->
    <div class="bg-[#1a1814] border border-[#cda45e]/30 rounded-xl p-8 lg:p-12 shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Cột thông tin món ăn -->
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-xs uppercase tracking-widest text-[#cda45e] bg-[#cda45e]/10 border border-[#cda45e]/30 px-3 py-1 rounded-full font-semibold">
              <%= dish.category %>
            </span>
            <% if (dish.available) { %>
              <span class="text-xs uppercase tracking-widest text-green-400 bg-green-500/10 border border-green-500/30 px-3 py-1 rounded-full font-semibold">
                ● Đang Phục Vụ
              </span>
            <% } else { %>
              <span class="text-xs uppercase tracking-widest text-amber-400 bg-amber-500/10 border border-amber-500/30 px-3 py-1 rounded-full font-semibold">
                ● Tạm Hết Món
              </span>
            <% } %>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-white font-bold mb-4 leading-tight">
            <%= dish.name %>
          </h1>

          <div class="text-2xl sm:text-3xl font-bold text-[#cda45e] font-serif mb-6">
            <%= Number(dish.price).toLocaleString('vi-VN') %> VNĐ
          </div>

          <div class="border-t border-b border-[#28251f] py-6 my-6">
            <h4 class="text-xs uppercase tracking-widest text-[#bab8b2] font-semibold mb-3">Mô tả hương vị ẩm thực</h4>
            <p class="text-base text-[#bab8b2] leading-relaxed italic">
              "<%= dish.description %>"
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a href="/menu" class="btn btn-outline-gold text-xs uppercase tracking-widest px-6 py-3 rounded-full">
              &larr; Trở Lại Thực Đơn
            </a>
            <a href="/admin/dishes/<%= dish.id %>/edit" class="btn btn-gold text-xs uppercase tracking-widest px-6 py-3 rounded-full">
              Chỉnh Sửa (Admin)
            </a>
          </div>
        </div>

        <!-- Cột hình ảnh minh họa đĩa tròn nghệ thuật (Hình ảnh 5) -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative group">
            <div class="w-64 h-64 sm:w-80 sm:h-80 rounded-full overflow-hidden border-4 border-[#cda45e]/40 shadow-2xl p-2 bg-[#151410]">
              <img 
                src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80" 
                alt="<%= dish.name %>" 
                class="w-full h-full object-cover rounded-full group-hover:scale-105 transition duration-500"
              >
            </div>
            <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-[#0c0b09] border border-[#cda45e] px-4 py-1 rounded-full text-xs text-[#cda45e] font-semibold tracking-wider whitespace-nowrap shadow-lg">
              Đặc Sản Nhà Hàng
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>
