<%- include('../partials/header') %>

<section class="py-16 bg-[#0c0b09] min-h-[calc(100vh-160px)] flex items-center justify-center">
  <div class="container mx-auto px-4 max-w-md">
    
    <!-- Tiêu đề trang -->
    <div class="text-center mb-8">
      <span class="section-subtitle text-xs uppercase tracking-widest text-[#cda45e] font-semibold">THIẾT LẬP MẬT KHẨU MỚI</span>
      <h1 class="text-3xl sm:text-4xl font-serif text-white mt-1">Đặt Lại Mật Khẩu</h1>
      <p class="text-xs text-[#8c8983] mt-2">
        Nhập mật khẩu mới cho tài khoản của bạn. Token chỉ được tiêu thụ khi xác nhận lưu mật khẩu mới.
      </p>
    </div>

    <!-- Thông báo lỗi -->
    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="bg-red-500/10 border border-red-500/40 rounded-lg p-4 mb-6 text-sm text-red-300">
        <div class="font-semibold flex items-center gap-2 mb-2 text-red-200">
          <span>⚠️</span> Vui lòng kiểm tra lại:
        </div>
        <ul class="list-disc list-inside space-y-1 text-xs leading-relaxed">
          <% errors.forEach(err => { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Card Form Đặt Lại Mật Khẩu -->
    <div class="bg-[#1a1814] border border-[#cda45e]/25 rounded-2xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-28 h-28 bg-[#cda45e]/10 rounded-full blur-2xl pointer-events-none"></div>

      <form id="resetPasswordForm" action="/reset" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

        <!-- Mật khẩu mới -->
        <div>
          <label for="password" class="block text-xs uppercase tracking-wider font-semibold text-white mb-2">
            Mật Khẩu Mới <span class="text-red-400">*</span>
          </label>
          <div class="relative">
            <input 
              type="password" 
              id="password" 
              name="password" 
              placeholder="Tối thiểu 8 ký tự (chữ cái và chữ số)" 
              required
              minlength="8"
              class="w-full bg-[#151410] border border-[#28251f] text-white pl-4 pr-10 py-3 rounded-lg focus:outline-none focus:border-[#cda45e] text-sm transition"
            >
            <button 
              type="button" 
              onclick="togglePwd('password', this)"
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-xs text-[#7f7c75] hover:text-[#cda45e] focus:outline-none"
            >
              👁️
            </button>
          </div>
        </div>

        <!-- Xác nhận mật khẩu mới -->
        <div>
          <label for="confirmPassword" class="block text-xs uppercase tracking-wider font-semibold text-white mb-2">
            Nhập Lại Mật Khẩu Mới <span class="text-red-400">*</span>
          </label>
          <div class="relative">
            <input 
              type="password" 
              id="confirmPassword" 
              name="confirmPassword" 
              placeholder="Nhập lại mật khẩu mới" 
              required
              minlength="8"
              class="w-full bg-[#151410] border border-[#28251f] text-white pl-4 pr-10 py-3 rounded-lg focus:outline-none focus:border-[#cda45e] text-sm transition"
            >
            <button 
              type="button" 
              onclick="togglePwd('confirmPassword', this)"
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-xs text-[#7f7c75] hover:text-[#cda45e] focus:outline-none"
            >
              👁️
            </button>
          </div>
          <p id="resetPwdMatchWarning" class="text-[11px] text-red-400 mt-1 hidden">Mật khẩu xác nhận không khớp với mật khẩu mới.</p>
          <p id="resetPwdMatchSuccess" class="text-[11px] text-emerald-400 mt-1 hidden">✓ Hai mật khẩu đã khớp.</p>
        </div>

        <div class="bg-[#151410] border border-[#cda45e]/20 rounded-lg p-3 text-[11px] text-[#8c8983] leading-relaxed">
          🔒 <strong class="text-[#cda45e]">Chính sách phiên:</strong> Sau khi đổi mật khẩu thành công, toàn bộ các phiên làm việc (Session) đang hoạt động của tài khoản sẽ bị hủy ngay lập tức.
        </div>

        <!-- Nút lưu mật khẩu -->
        <button 
          type="submit" 
          class="w-full btn btn-gold text-xs uppercase tracking-widest font-bold py-3.5 rounded-lg shadow-lg hover:shadow-[#cda45e]/20 transition duration-300"
        >
          Lưu Mật Khẩu Mới
        </button>
      </form>

    </div>

  </div>
</section>

<script>
  function togglePwd(id, btn) {
    const input = document.getElementById(id);
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🙈';
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
    }
  }

  const resetForm = document.getElementById('resetPasswordForm');
  const pwdInput = document.getElementById('password');
  const confirmPwdInput = document.getElementById('confirmPassword');
  const matchWarning = document.getElementById('resetPwdMatchWarning');
  const matchSuccess = document.getElementById('resetPwdMatchSuccess');

  function validatePasswordMatch() {
    if (!confirmPwdInput.value) {
      matchWarning.classList.add('hidden');
      matchSuccess.classList.add('hidden');
      confirmPwdInput.setCustomValidity('');
      return true;
    }

    if (pwdInput.value !== confirmPwdInput.value) {
      matchWarning.classList.remove('hidden');
      matchSuccess.classList.add('hidden');
      confirmPwdInput.setCustomValidity('Mật khẩu xác nhận không khớp.');
      return false;
    }

    matchWarning.classList.add('hidden');
    matchSuccess.classList.remove('hidden');
    confirmPwdInput.setCustomValidity('');
    return true;
  }

  pwdInput.addEventListener('input', validatePasswordMatch);
  confirmPwdInput.addEventListener('input', validatePasswordMatch);

  resetForm.addEventListener('submit', (e) => {
    if (!validatePasswordMatch()) {
      e.preventDefault();
      confirmPwdInput.reportValidity();
    }
  });
</script>

<%- include('../partials/footer') %>
