<%- include('../partials/header') %>

<section class="py-16 bg-[#0c0b09] min-h-[calc(100vh-160px)] flex items-center justify-center">
  <div class="container mx-auto px-4 max-w-md">
    
    <!-- Tiêu đề trang -->
    <div class="text-center mb-8">
      <span class="section-subtitle text-xs uppercase tracking-widest text-[#cda45e] font-semibold">KHÔI PHỤC TÀI KHOẢN</span>
      <h1 class="text-3xl sm:text-4xl font-serif text-white mt-1">Quên Mật Khẩu</h1>
      <p class="text-xs text-[#8c8983] mt-2">
        Nhập địa chỉ email để nhận liên kết đặt lại mật khẩu mới.
      </p>
    </div>

    <!-- Thông báo chung (Chống User Enumeration - Slide 42, 55, 61) -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="bg-emerald-500/10 border border-emerald-500/40 rounded-lg p-4 mb-6 text-sm text-emerald-300 flex items-start gap-2">
        <span class="text-base">✅</span>
        <span><%= successMessage %></span>
      </div>
    <% } %>

    <!-- Thông báo lỗi định dạng hoặc token không hợp lệ -->
    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="bg-red-500/10 border border-red-500/40 rounded-lg p-4 mb-6 text-sm text-red-300">
        <div class="font-semibold flex items-center gap-2 mb-2 text-red-200">
          <span>⚠️</span> Không thể thực hiện yêu cầu:
        </div>
        <ul class="list-disc list-inside space-y-1 text-xs leading-relaxed">
          <% errors.forEach(err => { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Card Form Quên Mật Khẩu -->
    <div class="bg-[#1a1814] border border-[#cda45e]/25 rounded-2xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-28 h-28 bg-[#cda45e]/10 rounded-full blur-2xl pointer-events-none"></div>

      <form action="/forgot" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        
        <!-- Email -->
        <div>
          <label for="email" class="block text-xs uppercase tracking-wider font-semibold text-white mb-2">
            Địa Chỉ Email Đã Đăng Ký <span class="text-red-400">*</span>
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#7f7c75]">
              ✉️
            </span>
            <input 
              type="email" 
              id="email" 
              name="email" 
              value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>"
              placeholder="tenban@example.com" 
              required
              class="w-full bg-[#151410] border border-[#28251f] text-white pl-10 pr-4 py-3 rounded-lg focus:outline-none focus:border-[#cda45e] text-sm transition"
            >
          </div>
        </div>

        <div class="bg-[#151410] border border-[#28251f] rounded-lg p-3 text-[11px] text-[#8c8983] leading-relaxed">
          🛡️ <strong class="text-[#cda45e]">Chính sách bảo mật:</strong> Liên kết đặt lại mật khẩu chỉ có hiệu lực trong vòng <strong>15 phút</strong>, chỉ dùng <strong>một lần</strong> và sẽ tự động thu hồi toàn bộ các phiên đăng nhập cũ sau khi đổi mật khẩu thành công.
        </div>

        <!-- Nút gửi yêu cầu -->
        <button 
          type="submit" 
          class="w-full btn btn-gold text-xs uppercase tracking-widest font-bold py-3.5 rounded-lg shadow-lg hover:shadow-[#cda45e]/20 transition duration-300"
        >
          Gửi Yêu Cầu Đặt Lại Mật Khẩu
        </button>
      </form>

      <div class="border-t border-[#28251f] mt-6 pt-5 text-center">
        <a href="/login" class="text-xs text-[#cda45e] hover:underline font-medium">
          &larr; Quay lại trang Đăng Nhập
        </a>
      </div>

    </div>

  </div>
</section>

<%- include('../partials/footer') %>
