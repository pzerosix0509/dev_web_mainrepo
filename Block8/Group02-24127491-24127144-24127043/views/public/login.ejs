<%- include('../partials/header') %>

<section class="py-16 bg-[#0c0b09] min-h-[calc(100vh-160px)] flex items-center justify-center">
  <div class="container mx-auto px-4 max-w-md">
    
    <!-- Tiêu đề trang -->
    <div class="text-center mb-8">
      <span class="section-subtitle text-xs uppercase tracking-widest text-[#cda45e] font-semibold">CHÀO MỪNG TRỞ LẠI</span>
      <h1 class="text-3xl sm:text-4xl font-serif text-white mt-1">Đăng Nhập</h1>
      <p class="text-xs text-[#8c8983] mt-2">
        Đăng nhập bằng phiên lưu bền vững (Persistent Session) để truy cập Thực Đơn và cụm quản trị CRUD.
      </p>
    </div>

    <!-- Thông báo thành công (sau khi kích hoạt OTP, đặt lại mật khẩu, hoặc đăng xuất) -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="bg-emerald-500/10 border border-emerald-500/40 rounded-lg p-4 mb-6 text-sm text-emerald-300 flex items-center gap-2">
        <span class="text-base">✅</span>
        <span><%= successMessage %></span>
      </div>
    <% } %>

    <!-- Thông báo lỗi -->
    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="bg-red-500/10 border border-red-500/40 rounded-lg p-4 mb-6 text-sm text-red-300">
        <div class="font-semibold flex items-center gap-2 mb-2 text-red-200">
          <span>⚠️</span> Đăng nhập không thành công:
        </div>
        <ul class="list-disc list-inside space-y-1 text-xs">
          <% errors.forEach(err => { %>
            <li><%= err %></li>
          <% }) %>
        </ul>
        <% if (typeof pendingEmail !== 'undefined' && pendingEmail) { %>
          <div class="mt-3 pt-3 border-t border-red-500/30">
            <a href="/activate?email=<%= encodeURIComponent(pendingEmail) %>" class="inline-block bg-[#cda45e] text-black font-semibold text-xs px-4 py-2 rounded-lg hover:bg-[#d9ba85] transition">
              &rarr; Đến Trang Nhập Mã OTP Kích Hoạt Ngay
            </a>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Card Form Đăng Nhập -->
    <div class="bg-[#1a1814] border border-[#cda45e]/25 rounded-2xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-28 h-28 bg-[#cda45e]/10 rounded-full blur-2xl pointer-events-none"></div>

      <form action="/login" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        
        <!-- Email (Giữ lại email khi đăng nhập lỗi theo Slide 24) -->
        <div>
          <label for="email" class="block text-xs uppercase tracking-wider font-semibold text-white mb-2">
            Địa Chỉ Email <span class="text-red-400">*</span>
          </label>
          <div class="relative">
            <input 
              type="email" 
              id="email" 
              name="email" 
              value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>"
              placeholder="tenban@example.com" 
              required
              class="w-full bg-[#151410] border border-[#28251f] text-white px-4 py-3 rounded-lg focus:outline-none focus:border-[#cda45e] text-sm transition"
            >
          </div>
        </div>

        <!-- Mật khẩu -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="password" class="block text-xs uppercase tracking-wider font-semibold text-white">
              Mật Khẩu <span class="text-red-400">*</span>
            </label>
            <a href="/forgot" class="text-[11px] text-[#cda45e] hover:underline">
              Quên mật khẩu?
            </a>
          </div>
          <div class="relative">
            <input 
              type="password" 
              id="password" 
              name="password" 
              placeholder="Nhập mật khẩu của bạn" 
              required
              class="w-full bg-[#151410] border border-[#28251f] text-white pl-4 pr-10 py-3 rounded-lg focus:outline-none focus:border-[#cda45e] text-sm transition"
            >
            <button 
              type="button" 
              onclick="toggleLoginPassword(this)"
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-xs text-[#7f7c75] hover:text-[#cda45e] focus:outline-none"
              title="Hiện/Ẩn mật khẩu"
            >
              👁️
            </button>
          </div>
        </div>

        <!-- Khung Thử Thách Chống Bot Cloudflare Turnstile (Chống Brute-force) -->
        <div class="pt-1">
          <label class="block text-xs uppercase tracking-wider font-semibold text-white mb-2">
            Xác Minh Bảo Mật Chống Bot (Cloudflare) <span class="text-[#cda45e]">*</span>
          </label>
          <input
            type="hidden"
            name="challengeId"
            id="loginCaptchaChallengeId"
            value="<%= typeof captcha !== 'undefined' && captcha ? captcha.challengeId : '' %>"
          >
          <div class="bg-[#151410] border border-[#28251f] rounded-lg p-3 flex justify-center">
            <div
              class="cf-turnstile"
              data-sitekey="<%= typeof captcha !== 'undefined' && captcha && captcha.siteKey ? captcha.siteKey : '1x00000000000000000000AA' %>"
              data-theme="dark"
            ></div>
          </div>
        </div>

        <!-- Nút Đăng Nhập -->
        <button 
          type="submit" 
          class="w-full btn btn-gold text-xs uppercase tracking-widest font-bold py-3.5 rounded-lg shadow-lg hover:shadow-[#cda45e]/20 transition duration-300"
        >
          Đăng Nhập
        </button>
      </form>

      <!-- Đường phân cách -->
      <div class="relative my-6 text-center">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-[#28251f]"></div></div>
        <span class="relative bg-[#1a1814] px-4 text-xs text-[#6e6b65] uppercase tracking-wider">Chưa kích hoạt hoặc chưa có tài khoản?</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a 
          href="/register" 
          class="w-full block text-center btn btn-outline-gold text-xs uppercase tracking-wider py-3 rounded-lg transition"
        >
          Tạo Tài Khoản
        </a>
        <a 
          href="/activate" 
          class="w-full block text-center bg-[#151410] border border-[#28251f] hover:border-[#cda45e] text-white text-xs uppercase tracking-wider py-3 rounded-lg transition"
        >
          Kích Hoạt OTP
        </a>
      </div>

    </div>

    <div class="text-center mt-6">
      <a href="/" class="text-xs text-[#8c8983] hover:text-[#cda45e] transition">
        &larr; Quay về Trang chủ Restaurantly
      </a>
    </div>

  </div>
</section>

<script>
  function toggleLoginPassword(btn) {
    const input = document.getElementById('password');
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🙈';
    } else {
      input.type = 'password';
      btn.textContent = '👁️';
    }
  }

</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<%- include('../partials/footer') %>
