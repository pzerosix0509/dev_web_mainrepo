{
  "name": "@gallery/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-env.mjs migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "6.12.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "file-type": "^22.3.0",
    "ioredis": "^5.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "6.12.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
