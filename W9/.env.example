NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://gallery:gallery@localhost:5432/gallery?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=photo-gallery
S3_ACCESS_KEY_ID=development-only
S3_SECRET_ACCESS_KEY=development-only
S3_FORCE_PATH_STYLE=true
MAX_FILES=5
MAX_FILE_BYTES=10485760
MAX_REQUEST_BYTES=57671680
MAX_DIMENSION=8000
MAX_PIXELS=25000000
IMAGE_PROCESSING_TIMEOUT_MS=30000
IMAGE_CONCURRENCY=2
ENABLE_WEBP_UPLOAD=true
ENABLE_DEEP_ZOOM=true
DEEP_ZOOM_MIN_PIXELS=12000000
VERSION_RETENTION_HOURS=24
VITE_API_URL=http://localhost:3001
